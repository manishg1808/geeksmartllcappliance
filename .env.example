# Copy to .env and fill in your values. Never commit .env to git.

APP_ENV=local
APP_DEBUG=false

# Database
DB_HOST=localhost
DB_NAME=geeksmartllcappli
DB_USER=root
DB_PASS=

# Admin panel (credentials live only in .env — not in code or database)
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD="change-this-strong-password"

# Public contact email (displayed on website only)
EMAIL_ADDRESS=support@geeksmartappliance.com
